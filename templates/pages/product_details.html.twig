{% extends 'base.html.twig' %}
{% set active_link = '' %}

{% block title %}Product Details - Our Store{% endblock %}

{% block body %}
    <!-- Product Details Section -->
    <div class="container my-5">
        <div class="row">
            <!-- Product Image -->
            <div class="col-md-6">
                <img src="{{ asset('images/airbod.png') }}" class="img-fluid rounded" alt="Product">
            </div>

            <!-- Product Information -->
            <div class="col-md-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-decoration-none">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Product Details</li>
                    </ol>
                </nav>

                <span class="badge {{ product.category.badgeClass }} mb-3">{{ product.category.name }}</span>
                
                <h1 class="mb-3">{{ product.name }}</h1>
                
                <h3 class="text-success mb-4">${{ product.price }}</h3>

                <div class="mb-4">
                    <h5>Description</h5>
                    <p class="text-muted">
                        {{ product.description }}
                    </p>
                </div>

                <!-- Add to Cart Form -->
                <form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post">
                    <div class="mb-3">
                        <label for="quantity" class="form-label">Quantity</label>
                        <input type="number" class="form-control" id="quantity" name="quantity" value="1" min="1" max="10" style="max-width: 100px;">
                    </div>

                    <div class="d-grid gap-2 d-md-flex">
                        <button type="submit" class="btn btn-primary btn-lg">Add to Cart</button>
                        <a href="{{ path('app_products') }}" class="btn btn-outline-secondary btn-lg">Continue Shopping</a>
                    </div>
                </form>

                <!-- Additional Info -->
                <div class="mt-4 pt-4 border-top">
                    <ul class="list-unstyled">
                        <li class="mb-2"><strong>SKU:</strong> {{ product.sku }}</li>
                        <li class="mb-2"><strong>Availability:</strong> <span class="text-success">{{ product.stockStatus }}</span></li>
                        <li class="mb-2"><strong>Category:</strong> <a href="{{ path('app_products_by_category', {'category': product.category.name}) }}">{{ product.category.name }}</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}