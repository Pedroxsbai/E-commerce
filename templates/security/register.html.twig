{% extends 'base.html.twig' %}
{% set active_link = 'login' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 bg-light border rounded shadow">
            <div class="card-body p-5">
                <h2 class="card-title mb-4">Créer un compte</h2>
                
                {{ form_start(registrationForm, {'attr': {'id': 'register'}}) }}
                    
                    {{ form_row(registrationForm.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
                    {{ form_row(registrationForm.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
                    {{ form_row(registrationForm.email, {'attr': {'class': 'form-control', 'placeholder': 'Votre email'}}) }}
                    
                    {{ form_row(registrationForm.password.first, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe'}}) }}
                    {{ form_row(registrationForm.password.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez le mot de passe'}}) }}
                    
                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-success btn-lg">S'inscrire</button>
                    </div>
                {{ form_end(registrationForm) }}

                <hr class="my-4">
                <p class="text-center text-muted">Déjà un compte ? <a href="{{ path('app_login') }}" class="text-decoration-none">Se connecter</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
